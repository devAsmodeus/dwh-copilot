# Образец файла настроек.
#
# Скопируйте в .env и укажите свои значения:
#     cp .env.example .env
#
# Файл .env внесён в .gitignore и в систему контроля версий не попадает.
# В промышленной установке значения передаются через систему управления
# секретами, а не через файл на диске.

# ─── Языковая модель ─────────────────────────────────────────────────────────

# Адрес сервера вывода с интерфейсом, совместимым с OpenAI.
# Подходят vLLM, SGLang, Ollama.
DWH_LLM_BASE_URL=http://localhost:8000/v1

# Имя модели на сервере вывода.
# Основной вариант: Qwen3-30B-A3B, разреженная модель на 30 миллиардов
# параметров, из которых на каждый токен задействуется 3,3 миллиарда.
# Даёт качество уровня плотной модели на 32 миллиарда при скорости уровня
# модели на 3 миллиарда, что решающе при 5-10 одновременных пользователях
# на одном ускорителе.
DWH_LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-AWQ

# Ключ доступа. Локальный vLLM значение не проверяет.
DWH_LLM_API_KEY=not-required

DWH_LLM_TIMEOUT_SECONDS=60

# ─── Хранилище данных ────────────────────────────────────────────────────────

DWH_MSSQL_HOST=localhost
DWH_MSSQL_PORT=1433
DWH_MSSQL_DATABASE=dwh_demo

# Учётная запись только для чтения. Права на базовые таблицы отозваны
# инструкцией DENY, доступны только представления схемы mart.
# Настройка выполняется скриптом sql/03_security.sql.
DWH_MSSQL_USER=dwh_reader
DWH_MSSQL_PASSWORD=Reader_Str0ng_P@ss!

DWH_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
DWH_MSSQL_TRUST_CERTIFICATE=true

# ─── Ограничения ─────────────────────────────────────────────────────────────

# Предельное время выполнения запроса в СУБД.
DWH_QUERY_TIMEOUT_SECONDS=30

# Пороги оценки стоимости, проверяемые ДО выполнения запроса.
# Отсекают запросы, законные по синтаксису и правам, но способные
# загрузить хранилище на десятки минут.
DWH_MAX_ESTIMATED_ROWS=1000000
DWH_MAX_ESTIMATED_COST=50

# Три разных ограничения числа строк, которые нельзя путать.
DWH_MAX_ROWS_TO_LLM=100
DWH_MAX_ROWS_TO_DISPLAY=5000

# Сколько раз модели даётся возможность исправить отклонённый запрос.
DWH_MAX_REPAIR_ATTEMPTS=2

# ─── Каталог витрин ──────────────────────────────────────────────────────────

DWH_VIEWS_MANIFEST=config/views.yaml
DWH_EXAMPLES_PATH=config/examples.yaml

# Сколько витрин с подробным описанием подаётся в запрос к модели.
# Компактный указатель по всем 50 витринам подаётся всегда.
DWH_TOP_K_VIEWS=8
DWH_TOP_K_EXAMPLES=4

# ─── Даты ────────────────────────────────────────────────────────────────────

# Дата актуальности данных. Периоды вида "последние три месяца" отсчитываются
# от неё, а не от сегодняшней даты. Иначе ответ содержит пустой хвост
# за ещё не загруженные дни.
# В промышленной установке значение читается из служебной таблицы хранилища.
DWH_DATA_AS_OF=2026-07-28

# ─── Пароль системного администратора СУБД ───────────────────────────────────
# Используется только при развёртывании демонстрационного стенда.

MSSQL_SA_PASSWORD=Str0ng_Sa_P@ssw0rd!
DWH_READER_PASSWORD=Reader_Str0ng_P@ss!
