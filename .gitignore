# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Среды разработки
.idea/
.vscode/
*.swp

# Локальные настройки. Файл .env содержит строку подключения к СУБД
# и учётные данные, в систему контроля версий не попадает.
.env
.env.local

# Исходное техническое задание. Документ принадлежит заказчику,
# в публичный репозиторий не выкладывается.
Домашнее_задание_*.pdf

# Рабочий журнал принятия решений. Внутренний документ с черновиками.
docs/decisions.md

# Результаты прогона набора бизнес-вопросов
eval/results/*.json
eval/results/*.html

# Журналы работы
logs/
*.log

# Служебные файлы операционных систем
.DS_Store
Thumbs.db
